<?xml version="1.0" encoding="utf-8"?>
<!-- The launcher may retain an old tall slot. Only the compact inner panel paints
     a background; no content height depends on that retained slot. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
<LinearLayout
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="top|center_horizontal"
    android:orientation="vertical" android:paddingHorizontal="12dp" android:paddingVertical="8dp" android:background="@drawable/widget_safar_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="36dp" android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:text="@string/widget_title" android:textSize="15sp" android:textStyle="bold" android:textColor="@color/widget_text"/>
        <ImageButton android:id="@+id/widget_refresh" android:layout_width="48dp" android:layout_height="match_parent"
            android:background="@drawable/widget_safar_touch" android:padding="12dp" android:src="@drawable/widget_refresh" android:contentDescription="@string/widget_refresh"/>
    </LinearLayout>
    <TextView android:id="@+id/widget_sign_in" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/widget_sign_in" android:textColor="@color/widget_secondary" android:textSize="14sp" android:paddingVertical="12dp" android:visibility="gone"/>
    <LinearLayout android:id="@+id/widget_content" android:layout_width="match_parent" android:layout_height="92dp" android:orientation="horizontal" android:baselineAligned="false">
        <LinearLayout android:layout_width="0dp" android:layout_weight="2" android:layout_height="match_parent" android:orientation="vertical">
            <LinearLayout android:id="@+id/widget_focus" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:paddingHorizontal="8dp" android:background="@drawable/widget_focus_panel">
                <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/widget_focus_icon" android:importantForAccessibility="no"/>
                <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_marginStart="5dp" android:gravity="center_vertical" android:text="@string/widget_focus" android:textColor="@color/widget_text" android:textSize="11sp" android:textStyle="bold" android:maxLines="2"/>
                <TextView android:id="@+id/widget_focus_value" android:layout_width="0dp" android:layout_weight="1.2" android:layout_height="match_parent" android:layout_marginStart="3dp" android:gravity="end|center_vertical" android:text="—" android:textColor="@color/widget_accent" android:textSize="20sp" android:textStyle="bold" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="10sp" android:autoSizeMaxTextSize="20sp"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/widget_kavach" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="6dp" android:gravity="center_vertical" android:paddingHorizontal="8dp" android:background="@drawable/widget_kavach_panel">
                <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/widget_shield_icon" android:importantForAccessibility="no"/>
                <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_marginStart="5dp" android:gravity="center_vertical" android:text="@string/widget_kavach" android:textColor="@color/widget_text" android:textSize="10sp" android:maxLines="2"/>
                <TextView android:id="@+id/widget_kavach_value" android:layout_width="0dp" android:layout_weight="1.2" android:layout_height="match_parent" android:layout_marginStart="3dp" android:gravity="end|center_vertical" android:text="—" android:textColor="@color/widget_orange" android:textSize="20sp" android:textStyle="bold" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="10sp" android:autoSizeMaxTextSize="20sp"/>
            </LinearLayout>
        </LinearLayout>
        <TextView android:layout_width="1dp" android:layout_height="match_parent" android:layout_marginHorizontal="8dp" android:background="@color/widget_divider" android:importantForAccessibility="no"/>
        <LinearLayout android:id="@+id/widget_goals" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:background="@drawable/widget_safar_touch">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="@string/widget_goals_compact" android:textColor="@color/widget_text" android:textStyle="bold" android:textSize="12sp"/>
            <FrameLayout android:layout_width="52dp" android:layout_height="52dp" android:layout_marginVertical="2dp">
                <ImageView android:id="@+id/widget_goal_ring" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/widget_goal_ring_empty" android:importantForAccessibility="no"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:padding="8dp">
                    <TextView android:id="@+id/widget_goal_fraction" android:layout_width="match_parent" android:layout_height="19dp" android:gravity="center" android:text="—" android:textColor="@color/widget_text" android:textStyle="bold" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="9sp" android:autoSizeMaxTextSize="15sp"/>
                    <TextView android:id="@+id/widget_goal_percent" android:layout_width="match_parent" android:layout_height="12dp" android:gravity="center" android:text="—" android:textColor="@color/widget_secondary" android:textSize="9sp"/>
                </LinearLayout>
            </FrameLayout>
            <TextView android:id="@+id/widget_goal_summary" android:layout_width="match_parent" android:layout_height="22dp" android:gravity="center" android:text="—" android:textColor="@color/widget_secondary" android:textSize="10sp" android:maxLines="2" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8sp" android:autoSizeMaxTextSize="10sp"/>
        </LinearLayout>
    </LinearLayout>
    <TextView android:id="@+id/widget_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="@string/widget_loading" android:textColor="@color/widget_secondary" android:textSize="9sp" android:maxLines="1" android:ellipsize="end" android:visibility="gone"/>
</LinearLayout>

</FrameLayout>
